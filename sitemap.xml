---
layout: null
permalink: /sitemap.xml
# Language-aware sitemap.
#
# Providing our own sitemap.xml disables jekyll-sitemap's generator (it only
# injects its template when no sitemap.xml exists). We need our own because the
# gem's template uses `absolute_url`, which polyglot does NOT prefix with the
# active language — so its generated /en/sitemap.xml wrongly points at the
# root (Chinese) URLs.
#
# Polyglot runs this template once per language build and writes the result
# into that language's destination (root for the default language, /<lang>/ for
# the others). Within each build `site.posts` / `site.html_pages` are already
# filtered to the active language, so we just prepend the language prefix.
---
{%- assign lang_prefix = '' -%}
{%- if site.active_lang and site.active_lang != site.default_lang -%}
  {%- assign lang_prefix = '/' | append: site.active_lang -%}
{%- endif -%}
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {%- assign collections = site.collections | where_exp: 'collection', 'collection.output != false' -%}
  {%- for collection in collections -%}
    {%- assign docs = collection.docs | where_exp: 'doc', 'doc.sitemap != false' -%}
    {%- for doc in docs -%}
      <url>
        <loc>{{ doc.url | replace: '/index.html', '/' | prepend: lang_prefix | absolute_url | xml_escape }}</loc>
        {%- if doc.last_modified_at or doc.date %}
        <lastmod>{{ doc.last_modified_at | default: doc.date | date_to_xmlschema }}</lastmod>
        {%- endif %}
      </url>
    {%- endfor -%}
  {%- endfor -%}

  {%- assign pages = site.html_pages | where_exp: 'doc', 'doc.sitemap != false' | where_exp: 'doc', 'doc.url != "/404.html"' -%}
  {%- for page in pages -%}
    <url>
      <loc>{{ page.url | replace: '/index.html', '/' | prepend: lang_prefix | absolute_url | xml_escape }}</loc>
      {%- if page.last_modified_at %}
      <lastmod>{{ page.last_modified_at | date_to_xmlschema }}</lastmod>
      {%- endif %}
    </url>
  {%- endfor -%}
</urlset>
